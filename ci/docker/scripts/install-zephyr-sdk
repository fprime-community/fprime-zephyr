#!/bin/sh
BASE_URL="https://github.com/zephyrproject-rtos/sdk-ng/releases/download"
VERSION="${1:-1.0.1}"
echo "${TARGETPLATFORM} -- ${2}"
TARGETPLATFORM="${2:-linux/amd64}"


# Calculate the platform token for Zephyr SDK
if [ "$TARGETPLATFORM" = "linux/amd64" ]
then
    PLATFORM=x86_64
elif [ "$TARGETPLATFORM" = "linux/arm64" ]
then
    PLATFORM=aarch64
else
    echo "[ERROR] SDK requested for invalid platform: ${TARGETPLATFORM}"
    exit 1
fi

# Get resources: SDK >= 1.0 ships a minimal bundle plus per-target toolchains
BUNDLE="zephyr-sdk-${VERSION}_linux-${PLATFORM}_minimal.tar.xz"
TOOLCHAIN="toolchain_gnu_linux-${PLATFORM}_arm-zephyr-eabi.tar.xz"
for ARCHIVE in "${BUNDLE}" "${TOOLCHAIN}"
do
    echo "[DOWNLOAD] GETing: ${BASE_URL}/v${VERSION}/${ARCHIVE}"
    wget -q "${BASE_URL}/v${VERSION}/${ARCHIVE}"
done
wget -q -O - "${BASE_URL}/v${VERSION}/sha256.sum" | shasum --check --ignore-missing

# Unarchive and install
mkdir -p /opt
tar -C /opt -xf "${BUNDLE}"
mkdir -p "/opt/zephyr-sdk-${VERSION}/gnu"
tar -C "/opt/zephyr-sdk-${VERSION}/gnu" -xf "${TOOLCHAIN}"
